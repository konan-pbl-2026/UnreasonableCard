<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/helpNormalScreen"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:visibility="gone">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="通常モードの遊び方"
        android:textSize="28sp"
        android:textStyle="bold"
        android:layout_marginBottom="24dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="・手札からカード（✊ ✌️ ✋）を選んで勝負します。\n\n・じゃんけんに勝つと相手のライフ（♥）を1削ります。\n\n・通常モードはライフ3 / 手札5枚です。\n\n・先に相手のライフを0にするか、手札がなくなった時の残りライフが多い方の勝ちです。"
        android:textSize="16sp"
        android:lineSpacingExtra="6dp"
        android:layout_marginBottom="40dp" />

    <Button
        android:id="@+id/normalHelpBackButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="説明選択に戻る"
        android:textSize="20sp" />

</LinearLayout>