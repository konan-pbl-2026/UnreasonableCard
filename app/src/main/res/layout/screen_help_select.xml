<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/helpSelectScreen"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="bottom|center_horizontal"
    android:paddingStart="32dp"
    android:paddingEnd="32dp"
    android:paddingBottom="120dp"
    android:visibility="gone">

    <!-- 遊び方説明の画像 -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:src="@drawable/rule"
        android:adjustViewBounds="true"
        android:scaleType="fitCenter"
        android:layout_marginBottom="40dp"
        android:contentDescription="遊び方説明" />

    <Button
        android:id="@+id/normalHelpButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="通常モードの説明"
        android:textSize="20sp"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/specialHelpButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="特殊モードの説明"
        android:textSize="20sp"
        android:layout_marginBottom="32dp" />

    <Button
        android:id="@+id/helpSelectBackButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="タイトルに戻る"
        android:textSize="20sp" />

</LinearLayout>
