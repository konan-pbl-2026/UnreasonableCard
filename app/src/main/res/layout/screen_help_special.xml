<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/helpSpecialScreen"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:visibility="gone">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="特殊モードの遊び方"
        android:textSize="28sp"
        android:textStyle="bold"
        android:layout_marginBottom="24dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="・特殊カード：カードを出すと、じゃんけん勝負後に、カード特有の効果が発動する\n\n・勝ち負け逆転：勝敗が入れ替わる\n\n・ライフ回復：勝つとライフが増え、負けると減る。引き分けには効果がない\n\n・後出し：勝負をした後、自分の手札と現在の手札を入れ替えることができる。また、出していたカードはそのまま自分の手札に戻る。\n\n・先に相手のライフを0にするか、手札がなくなった時の残りライフが多い方の勝ちです。"
        android:textSize="16sp"
        android:lineSpacingExtra="6dp"
        android:layout_marginBottom="40dp" />

    <Button
        android:id="@+id/specialHelpBackButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="説明選択に戻る"
        android:textSize="20sp" />

</LinearLayout>